            "screen-00c8b68d46ff",
            "screen-89cc235bbe7c"
          ],
          "videos": []
        },
        {
          "id": "speak-02",
          "order": 2,
          "title": "身份入口与虚构昵称",
          "phase": "身份",
          "text": "账号页提供身份衔接入口，返回应用后进入昵称流程。本次使用编造昵称 Alex，之后由 Tutor 开始了解目标。",
          "images": [
            "speak-entry",
            "screen-c98382b513bb"
          ],
          "videos": []
        },
        {
