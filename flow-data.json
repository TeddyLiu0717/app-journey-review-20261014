    "speak": {
      "app": "Speak",
      "sequence_boundary": "10/03首课及后续实践/对话/自定义课程跨批样本；成人产品仅对照机制。",
      "gaps": [
        "私人Google账号选择器跳过",
        "课内合成输入与实际提交须RPC/动作记录；静态绿字不当逐字转写"
      ],
      "steps": [
        {
          "id": "speak-01",
          "order": 1,
          "title": "学习语言及界面语言",
          "phase": "身份",
          "text": "首次进入先选择学习语言，再选择母语或界面语言。本次选择学习英语，后续页面使用简体中文继续引导。",
